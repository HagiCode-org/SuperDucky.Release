---
// Shared release page for every locale. Reads the same data module as release.json, so the two always agree.
import { release } from "../data/release.ts";
import { PLATFORM_IDS } from "../lib/release-data.ts";
import { COPY, GITHUB_RELEASES_URL, MICROSOFT_STORE_URL, type SiteLocale } from "../lib/copy.ts";
import "../styles/site.css";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const copy = COPY[locale];
const htmlLang = locale;
const publishedDate = release.publishedAt.slice(0, 10);
const formatSize = (bytes: number) =>
  bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
// Keep the platform order fixed; "other" always comes last.
const assets = PLATFORM_IDS.flatMap((platform) => release.assets.filter((asset) => asset.platform === platform));
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.description} />
    <meta name="color-scheme" content="light dark" />
    <title>{copy.htmlTitle}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <p class="brand">SuperDucky</p>
        <a class="switch" href={copy.switchHref} hreflang={locale === "en" ? "zh-CN" : "en"}>{copy.switchLabel}</a>
      </header>

      <main>
        <section class="intro">
          <p class="kicker">{copy.kicker}</p>
          <h1>{copy.title}</h1>
          <p class="lead">{copy.lead}</p>
        </section>

        <section class="card" aria-labelledby="latest-heading">
          <h2 id="latest-heading">{copy.latest}</h2>
          <dl class="meta">
            <div>
              <dt>{copy.version}</dt>
              <dd>{release.tag}</dd>
            </div>
            <div>
              <dt>{copy.published}</dt>
              <dd><time datetime={release.publishedAt}>{publishedDate}</time></dd>
            </div>
          </dl>
        </section>

        <section class="card" aria-labelledby="downloads-heading">
          <h2 id="downloads-heading">{copy.downloads}</h2>
          <ul class="downloads">
            {assets.map((asset) => (
              <li>
                <a class="download" href={asset.url}>
                  <span class="badge">{copy.platformLabels[asset.platform]}</span>
                  <span class="asset-name">{asset.name}</span>
                  <span class="asset-size">{formatSize(asset.size)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="card" aria-labelledby="notes-heading">
          <h2 id="notes-heading">{copy.notes}</h2>
          {release.notes.trim() ? (
            <div class="notes">{release.notes.trim()}</div>
          ) : (
            <p>{copy.notesEmpty}</p>
          )}
        </section>

        <section class="card" aria-labelledby="store-heading">
          <h2 id="store-heading">{copy.storeTitle}</h2>
          <p>{copy.storeNote}</p>
          <a class="pill" href={MICROSOFT_STORE_URL}>{copy.storeLink}</a>
        </section>

        <section class="card" aria-labelledby="feed-heading">
          <h2 id="feed-heading">{copy.feedTitle}</h2>
          <p>{copy.feedNote} <a href="/release.json"><code>/release.json</code></a></p>
        </section>
      </main>

      <footer class="site-footer">
        <a href={GITHUB_RELEASES_URL}>{copy.allReleases}</a>
        <a href={copy.officialSiteHref}>{copy.officialSite}</a>
      </footer>
    </div>
  </body>
</html>
